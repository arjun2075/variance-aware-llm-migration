# Copy to .env (gitignored) and fill in. NEVER commit real values.
# All credentials are read from the environment; nothing is stored in code.

# OpenAI public API — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic public API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# AWS Bedrock (Amazon Nova, Meta Llama). Prefer a standard AWS credential
# mechanism (~/.aws/credentials, SSO, or an instance role) over these vars.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: cap spend in the orchestrator (USD). Refuses to launch above this.
VAML_MAX_SPEND_USD=500
