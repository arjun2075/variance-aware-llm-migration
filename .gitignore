# ---------------------------------------------------------------------------
# CREDENTIALS — never commit. API keys load from environment only.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/
secrets.json

# ---------------------------------------------------------------------------
# Raw provider payloads and run outputs (large; regenerable or archived)
# ---------------------------------------------------------------------------
results/raw/
results/batch/
*.npz
runs*.jsonl
!corpora/**/*.jsonl

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# ---------------------------------------------------------------------------
# Raw third-party datasets — NEVER committed.
# ContractNLI is CC BY 4.0 but distributed behind a click-through Terms of Use.
# The original files stay local; only derived task IDs, hashes and manifests
# are committed. Redistributing the source here would bypass that ToU.
# ---------------------------------------------------------------------------
# Ignore raw dataset files by extension rather than the whole directory:
# git does not descend into an excluded directory, so a blanket `data/raw/`
# would make the `!` negations below unreachable and hide the README too.
data/raw/**/*.json
data/raw/**/*.jsonl
data/raw/**/*.zip
data/raw/**/*.tar
data/raw/**/*.tar.gz
data/raw/**/*.csv
data/raw/**/*.parquet
# Upstream LICENSE/TERMS shipped with the dataset: kept locally for the record,
# not re-published here. The license is cited in the corpus manifest instead.
data/raw/**/LICENSE
data/raw/**/TERMS

# Compiled transport-helper binary (36MB, rebuilt from source in the service module)
bin/

# Confirmatory run ledger (large, regenerated by execution; summarised in reports)
results/run/

# Local machine paths for run_control.sh
vaml.env

# ledger backups
results/run/*.pre_auth_purge

results/analysis_BUGGY_DISCARDED/
results/*.log

# replication credentials - never commit
.replication.env

results/replication/*.pre_429_purge

# strengthening sim logs
results/sim.log

results/budget.log
results/resolution.log
results/chain.log

results/si.log
results/inv.log

results/*.log
dist/
